# Production Environment Configuration
# ============================================================

# TMDB Configuration (TMDB API)
# Get API key from: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your-tmdb-api-key-here

# OMDb Configuration (Alternative - Excellent for detailed movie info)
# Get API key from: https://www.omdbapi.com/apikey.aspx
VITE_OMDB_API_KEY=your-omdb-api-key-here

# Trakt.tv Configuration (Best for TV shows & trending content)
# Get API key from: https://trakt.tv/oauth/applications
VITE_TRAKT_API_KEY=your-trakt-api-key-here
VITE_TRAKT_CLIENT_ID=your-trakt-client-id

# TVmaze Configuration (Best for TV show details & episodes)
# Get API key from: https://www.tvmaze.com/api
VITE_TVMAZE_API_KEY=your-tvmaze-api-key-here

# Simkl Configuration (Great for user lists & watchlist)
# Get API key from: https://simkl.com/settings/apps
VITE_SIMKL_API_KEY=your-simkl-api-key-here
VITE_SIMKL_CLIENT_ID=your-simkl-client-id

# Supabase Configuration (Optional - for user data)
# Get these values from your Supabase project dashboard: https://supabase.com
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-anonymous-key-here

# API Configuration
# Primary API to use for search (options: tmdb, omdb, trakt, tvmaze, simkl)
VITE_PRIMARY_API=tmdb

# Enable multiple API fallbacks for better reliability
VITE_API_FALLBACK_ENABLED=true

# API Request Timeout (in milliseconds)
VITE_API_TIMEOUT=8000

# Backend Server Configuration
PORT=4000
BACKEND_API_URL=http://localhost:4000

# Movie/TV Show Streaming Priority
# Comma-separated list of preferred streaming sources
VITE_STREAM_PRIORITY=tmdb,omdb,trakt,tvmaze,simkl

# Sports APIs
# Football & General Sports (API-Football / api-sports.io)
VITE_SPORTS_API_KEY=your-api-sports-key-here
# Cricket API (cricapi.com)
VITE_CRICKET_API_KEY=your-cricapi-key-here
