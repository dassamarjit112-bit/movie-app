# Production Environment Configuration
# ============================================================
# TMDB Configuration (REQUIRED for production)
# Get API key from: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your-production-tmdb-api-key-here

# Supabase Configuration (Optional - for user data)
# Get these values from your Supabase project dashboard: https://supabase.com
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-anonymous-key-here
